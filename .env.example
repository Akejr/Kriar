# ---------------------------------------------------------------------------
# Kriar — variáveis de ambiente
#
# Copia para `.env.local` e preenche. A configuração escolhida para este
# projecto é SUPABASE (persistência) + OPENROUTER (texto e imagem).
#
# Sem variáveis nenhumas a aplicação arranca em MODO DE DEMONSTRAÇÃO: dados
# no browser e composição determinística. Serve para experimentar, mas não é
# a configuração de produção.
#
# Só as duas variáveis NEXT_PUBLIC_ do Supabase chegam ao browser, e são
# públicas por design — o isolamento entre contas é feito por políticas RLS
# no servidor. A chave do OpenRouter NUNCA é exposta: todas as chamadas de IA
# passam por rotas de API em `src/app/api/ai/`.
# ---------------------------------------------------------------------------


# === 1. Supabase — persistência =============================================
# Painel do Supabase → Project Settings → Data API
# Preenche AS DUAS. Se faltar uma, a aplicação usa IndexedDB no browser.
#
# Antes do primeiro arranque, aplica as migrações em `supabase/migrations/`:
#   supabase db push
# ou cola os dois ficheiros no editor SQL do painel, por ordem.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# === 2. OpenRouter — texto e imagem =========================================
# Uma chave serve os dois papéis: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Planeamento de texto ---------------------------------------------------
# Propõe títulos, chamada para acção e escolhe o modelo de composição.
# Confirma um identificador actual em https://openrouter.ai/models
# Prefere um modelo que suporte `response_format: json_object`.
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# --- Geração de fundos ------------------------------------------------------
# Gera APENAS fundos. Textos, logótipo, contactos, preço e fotografias de
# produto ficam em camadas controladas pela aplicação.
# Catálogo: https://openrouter.ai/collections/image-models
# O gpt-5.4-image-2 raciocina sobre a instrucao antes de gerar, e e isso que
# compramos: obediencia a margens, logotipo completo, cores da paleta.
# Cerca de 0.20 USD e 86s por arte. Alternativa mais barata e mais rapida:
# openai/gpt-image-2.5-sunburst (0.05 USD, 40s), com menos rigor nas margens.
OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
# Patamar de resolucao: 512 | 1K | 2K | 4K.
# 1K basta: a arte tem 1080 px de largura e 2K devolvia 8 MB por fundo.
OPENROUTER_IMAGE_RESOLUTION=1K

# --- Atribuição (opcional) --------------------------------------------------
# Aparecem no painel de consumo do OpenRouter para identificar a aplicação.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Kriar


# === 3. Escolha explícita de fornecedor (opcional) ==========================
# Sem estas variáveis, a aplicação usa o OpenRouter se houver chave.
# Define-as só para forçar outro fornecedor.
#   texto:  openrouter | openai | anthropic | google
#   imagem: openrouter | openai | stability
KRIAR_TEXT_PROVIDER=
KRIAR_IMAGE_PROVIDER=


# === 4. Alternativas directas (opcional) ====================================
# Não são necessárias com o OpenRouter configurado. Ficam disponíveis para
# quem preferir ligar directamente a um fornecedor.

# OpenAI, ou qualquer endpoint compatível com /v1/chat/completions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-3-5-haiku-latest

# Google (Gemini)
GOOGLE_AI_API_KEY=
GOOGLE_TEXT_MODEL=gemini-2.0-flash

# Stability (apenas imagem)
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=sd3.5-medium
